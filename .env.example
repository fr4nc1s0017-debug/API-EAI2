# Igual al API_KEY programado en el firmware Arduino (NO subir claves reales a Git).
DEVICE_API_KEY=REEMPLAZAR_CON_CLAVE_DEL_ARDUINO
# Clave DIFERENTE, privada, para controlar el panel web.
ADMIN_API_KEY=REEMPLAZAR_CON_CLAVE_ADMINISTRATIVA
PORT=3000
DATA_FILE=./data/estado.json
# Dominio HTTPS exacto de tu WEB, sin slash final. Varios: separados por comas.
CORS_ORIGINS=https://tu-web.onrender.com
